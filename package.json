{
  "name": "app-b20",
  "private": true,
  "version": "0.0.0",
  "description": "Plataforma colaborativa del grupo B20 (web/PWA, extensión Chrome, APK Android).",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run dev -w @b20/web",
    "dev:api": "npm run dev -w @b20/api",
    "build": "npm run build -w @b20/web && npm run build -w @b20/extension && npm run build -w @b20/api",
    "build:web": "npm run build -w @b20/web",
    "build:extension": "npm run build -w @b20/extension",
    "build:android": "npm run build -w @b20/web -- --mode capacitor && npm run sync -w @b20/android",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "spacetime:publish": "spacetime publish --project-path packages/spacetime-module app-b20",
    "spacetime:generate": "spacetime generate --lang typescript --out-dir packages/app/src/module_bindings --project-path packages/spacetime-module"
  },
  "devDependencies": {
    "typescript": "~5.9.3"
  }
}
