{
  "name": "app-b20",
  "private": true,
  "version": "0.0.0",
  "description": "Plataforma colaborativa del grupo B20 (web/PWA, extensión Chrome, APK Android).",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run dev -w @b20/web",
    "dev:api": "npm run dev -w @b20/api",
    "prebuild": "node scripts/check-node.mjs",
    "build": "npm run build -w @b20/web && npm run build -w @b20/extension && npm run build -w @b20/api && npm run build:ai -w @b20/api",
    "build:web": "npm run build -w @b20/web",
    "prebuild:pages": "node scripts/check-node.mjs",
    "build:pages": "npm run build -w @b20/web -- --mode pages",
    "pages:dev": "wrangler pages dev",
    "pages:deploy": "npm run build:pages && wrangler pages deploy",
    "build:extension": "npm run build -w @b20/extension",
    "build:android": "npm run build -w @b20/web -- --mode capacitor && npm run sync -w @b20/android",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:spacetime:files": "node scripts/smoke-spacetime-files.mjs",
    "test:spacetime:delivery2": "node scripts/smoke-spacetime-delivery2.mjs",
    "test:spacetime:rooms": "node scripts/smoke-spacetime-rooms.mjs",
    "test:spacetime:notifications": "node scripts/smoke-spacetime-notifications.mjs",
    "test:spacetime:retention": "node scripts/smoke-spacetime-retention.mjs",
    "spacetime:publish": "spacetime publish --server http://localhost:3000 --module-path packages/spacetime-module app-b20",
    "spacetime:publish:maincloud": "spacetime publish --server maincloud --module-path packages/spacetime-module --delete-data=never app-b20-34245",
    "spacetime:generate": "spacetime generate --lang typescript --out-dir packages/app/src/module_bindings --module-path packages/spacetime-module",
    "test:spacetime:presentations": "node scripts/smoke-spacetime-presentations.mjs",
    "test:spacetime:ai": "node scripts/smoke-spacetime-ai.mjs",
    "test:spacetime:guides": "node scripts/smoke-spacetime-guides.mjs"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "wrangler": "^4.151.3"
  }
}
