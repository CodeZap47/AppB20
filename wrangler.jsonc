{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Cambiar este nombre si Cloudflare asigna uno distinto al crear el proyecto.
  "name": "app-b20",
  "pages_build_output_dir": "./apps/web/dist",
  "compatibility_date": "2026-10-20",
  // Pages toma estas variables públicas como fuente de verdad del build.
  // Los secretos del backend nunca se configuran aquí.
  "vars": {
    "VITE_DATA_MODE": "spacetime",
    "VITE_WEB_ORIGIN": "https://b20.mx",
    // El subdominio de Pages y sus aliases redirigen a VITE_WEB_ORIGIN.
    "VITE_PAGES_ORIGIN": "https://app-b20.pages.dev",
    "VITE_SPACETIME_URI": "wss://maincloud.spacetimedb.com",
    "VITE_SPACETIME_DB": "app-b20-34245",
    // Supabase Auth: URL del proyecto y clave pública (sb_publishable_). Nunca la secreta.
    "VITE_SUPABASE_URL": "https://tgtvvbqlmlljuufrutbk.supabase.co",
    "VITE_SUPABASE_PUBLISHABLE_KEY": "sb_publishable_0NFFjRsPlzdm6ZLvpyBijQ__tA64ltK",
    "VITE_SUPABASE_OAUTH_PROVIDERS": "",
    "VITE_SUPABASE_PASSKEYS_ENABLED": "false",
    // Vacío: ningún archivo usa ya R2; todos viven en SpacetimeDB.
    "VITE_API_URL": "",
    "VITE_AI_API_URL": "https://app-b20-ai.aguaseero.workers.dev",
    "VITE_VAPID_PUBLIC_KEY": "BDcU2DLr4bYXsOFyDIR5GJIPFDP8lg0UTdSUg4T7HhSvrO0fIK_YEuXE1cxySQIjYANBXvGBxmL-r6t4bN6nBBo"
  }
}
