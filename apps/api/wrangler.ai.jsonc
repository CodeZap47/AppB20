{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // API de B20 (acceso, IA, avisos y correos), ligada al dominio del proyecto.
  "name": "b20-api",
  "account_id": "ab3a0c0641ce296cd9f38fab76f6d90b",
  "main": "src/guideWorker.ts",
  "compatibility_date": "2026-10-21",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "routes": [
    { "pattern": "api.b20.mx", "custom_domain": true }
  ],
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "CORS_ORIGINS": "https://b20.mx,https://app-b20.pages.dev,http://localhost:5173,capacitor://localhost,https://localhost",
    "OIDC_ISSUER": "https://pypdkigeywdughdhxlcm.supabase.co/auth/v1",
    "OIDC_AUDIENCE": "authenticated",
    "OIDC_JWKS_URI": "https://pypdkigeywdughdhxlcm.supabase.co/auth/v1/.well-known/jwks.json",
    "SPACETIMEDB_URI": "https://maincloud.spacetimedb.com",
    "SPACETIMEDB_MODULE": "app-b20-34245",
    "AI_ENABLED": "true",
    // v1 se perdió al borrar el Worker anterior; las claves de Gemini guardadas con v1 deben volver a guardarse.
    "AI_MASTER_VERSION": "v2",
    "GEMINI_MODEL": "gemini-3.8-flash",
    "AGENT_AI_STEPS": "style",
    "NOTIFICATIONS_ENABLED": "true",
    "VAPID_PUBLIC_KEY": "BI3gEf_VjuIUVWb__T2opJzEo-boIJ1L4-gRWSJptTM5VTVvbn8hAZPW5ixl92Iq1_FWkk1gmalQxu1wmxj_36U",
    "VAPID_SUBJECT": "https://b20.mx",
    "INVITATION_EMAILS_ENABLED": "false",
    "INVITATION_EMAIL_FROM": "",
    "APP_URL": "https://b20.mx",
    // La clave secreta va como secreto del Worker: wrangler secret put SUPABASE_SECRET_KEY.
    "SUPABASE_URL": "https://pypdkigeywdughdhxlcm.supabase.co"
  },
  "send_email": [
    {
      "name": "EMAIL"
    }
  ],
  "secrets": {
    "required": [
      "AI_SERVICE_TOKEN",
      "AI_MASTER_KEYS_JSON",
      "NOTIFICATION_SERVICE_TOKEN",
      "VAPID_PRIVATE_KEY"
    ]
  },
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  }
}
