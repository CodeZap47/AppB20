{
  "name": "@b20/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "API de archivos privados en Cloudflare Workers y R2.",
  "scripts": {
    "dev": "wrangler dev --local",
    "dev:legacy": "node --env-file-if-exists=../../.env --watch --experimental-strip-types src/server.ts",
    "start": "wrangler dev --local",
    "types": "wrangler types --env-interface FileWorkerEnv --strict-vars=false",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "typecheck": "tsc -p tsconfig.json",
    "email:templates": "node --experimental-strip-types src/email/generate.ts",
    "test": "vitest run",
    "build:ai": "wrangler deploy --config wrangler.ai.jsonc --dry-run --outdir dist-ai"
  },
  "dependencies": {
    "@b20/core": "*",
    "@google/genai": "^2.28.0",
    "@hono/node-server": "^2.1.4",
    "hono": "^4.13.13",
    "jose": "^6.2.12"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "vitest": "^5.0.3",
    "miniflare": "5.20261019.1-beta",
    "esbuild": "^0.28.2"
  }
}
