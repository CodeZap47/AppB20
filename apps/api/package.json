{
  "name": "@b20/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Backend autenticado: Gemini BYOK, archivos y envío de avisos push.",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --watch --experimental-strip-types src/server.ts",
    "start": "node --env-file-if-exists=../../.env dist/server.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@google/genai": "^2.28.0",
    "@hono/node-server": "^2.1.4",
    "hono": "^4.13.13",
    "jose": "^6.2.12"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "vitest": "^5.0.3"
  }
}
