# Configuración PÚBLICA de la web B20 para Cloudflare Pages.
# Para compilar en esta computadora: copiar a .env.pages (ignorado por Git).
# En Cloudflare, los mismos valores públicos se mantienen en vars de wrangler.jsonc.
# No añadir client secrets, claves de Gemini ni credenciales de servidor.
VITE_DATA_MODE=spacetime
# Producción usa Supabase. Estos valores son públicos; los secretos viven en Cloudflare.
VITE_AUTH_PROVIDER=supabase
# Para cambiar de proveedor, conservar las vinculaciones y revisar docs/supabase-auth.md.
VITE_SUPABASE_URL=https://pypdkigeywdughdhxlcm.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_5aj-zMaEnGAXL5XAK7wfcg_gtJv6axe
VITE_SUPABASE_OAUTH_PROVIDERS=
VITE_SUPABASE_PASSKEYS_ENABLED=false
VITE_WEB_ORIGIN=https://b20.mx
# Subdominio de Pages; él y sus aliases redirigen a VITE_WEB_ORIGIN.
VITE_PAGES_ORIGIN=https://app-b20.pages.dev
VITE_SPACETIME_URI=wss://maincloud.spacetimedb.com
VITE_SPACETIME_DB=app-b20-34245
VITE_SPACETIMEAUTH_CLIENT_ID=client_034jL0AHYYQ1bps8SupHU0
VITE_SPACETIMEAUTH_AUTHORITY=https://auth.spacetimedb.com/oidc
# Se calculan desde el dominio actual: /auth/callback y /auth/logout.
# Registrar las dos URLs HTTPS exactas en SpacetimeAuth una vez creado el proyecto Pages.
VITE_SPACETIMEAUTH_REDIRECT_URI=
VITE_SPACETIMEAUTH_POST_LOGOUT_REDIRECT_URI=
# API de compatibilidad para las descargas heredadas de R2.
# Las cargas nuevas usan SpacetimeDB; puede dejarse vacío sin archivos heredados.
VITE_API_URL=
VITE_VAPID_PUBLIC_KEY=BI3gEf_VjuIUVWb__T2opJzEo-boIJ1L4-gRWSJptTM5VTVvbn8hAZPW5ixl92Iq1_FWkk1gmalQxu1wmxj_36U

# API de IA; vacío reutiliza VITE_API_URL. Nunca contiene claves.
VITE_AI_API_URL=https://api.b20.mx
# Servicio de enlaces; vacío reutiliza VITE_AI_API_URL y después VITE_API_URL.
# No es necesario activar las descargas heredadas de R2 para administrar enlaces.
VITE_INVITATION_API_URL=
