# Copia este archivo a .env.local (web) o .env (api) y llena los valores.
# Nunca pongas claves reales en el repositorio ni en chats o documentos compartidos.

# ---- Cliente (web, extensión, Android) ----
# Supabase Auth (proyecto pypdkigeywdughdhxlcm) es el único proveedor de inicio de sesión. Guía: docs/supabase-auth.md
VITE_SUPABASE_URL=https://pypdkigeywdughdhxlcm.supabase.co
# Clave pública sb_publishable_ (nunca la secreta).
VITE_SUPABASE_PUBLISHABLE_KEY=
# Habilitar únicamente los métodos configurados en el panel del proyecto.
VITE_SUPABASE_OAUTH_PROVIDERS=
VITE_SUPABASE_PASSKEYS_ENABLED=false
# Temporal: login real y datos simulados. `spacetime` activa los datos reales con membresía.
VITE_DATA_MODE=demo
# Solo `npm run dev` con datos demo: `true` entra sin iniciar sesión. Los builds lo ignoran.
VITE_DEV_AUTH_BYPASS=
# URL del servidor SpacetimeDB (ws:// en local, wss:// en producción)
VITE_SPACETIME_URI=ws://localhost:3000
# Nombre de la base publicada con `npm run spacetime:publish`
VITE_SPACETIME_DB=app-b20
# Worker Cloudflare para Gemini BYOK y descargas heredadas de R2.
# Los archivos nuevos se transfieren directamente a SpacetimeDB. Sin IA ni archivos
# heredados puede dejarse vacío. Secretos del Worker: docs/gemini-byok.md.
VITE_API_URL=
# Clave pública VAPID para Web Push (la privada solo vive en el backend)
VITE_VAPID_PUBLIC_KEY=

# ---- API Node de desarrollo heredada (no se publica en esta entrega) ----
# El Worker de producción usa SpacetimeDB + Cloudflare Secrets: docs/gemini-byok.md.
# Estas variables heredadas no configuran ni habilitan el Worker de producción.
PORT=8787
# Orígenes permitidos separados por coma (web, extensión, Capacitor)
CORS_ORIGINS=http://localhost:5173,capacitor://localhost,https://localhost
# Supabase Auth: emisor, audiencia y claves públicas del proyecto.
OIDC_ISSUER=https://pypdkigeywdughdhxlcm.supabase.co/auth/v1
OIDC_AUDIENCE=authenticated
OIDC_JWKS_URI=https://pypdkigeywdughdhxlcm.supabase.co/auth/v1/.well-known/jwks.json
# La API comprueba la membresía con el token del usuario antes de permitir acceso a /ai.
SPACETIMEDB_URI=http://localhost:3000
SPACETIMEDB_MODULE=app-b20
# Único almacén admitido por la API local: en memoria, se pierde al reiniciar.
SECRET_STORE=memory
# Clave de 32 bytes en base64 para cifrarlas durante el desarrollo local.
# Genera una con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BYOK_ENCRYPTION_KEY=
# Modelo de Gemini; confirma el vigente en https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=
# Web Push del Worker: configuración completa en docs/avisos-recordatorios.md.
# No se requiere una cuenta Firebase ni el SDK FCM.
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:

# API de IA; vacío reutiliza VITE_API_URL. Nunca contiene claves.
VITE_AI_API_URL=
# Servicio de enlaces; vacío reutiliza VITE_AI_API_URL y después VITE_API_URL.
VITE_INVITATION_API_URL=
