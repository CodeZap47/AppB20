# Copia este archivo a .env.local (web) o .env (api) y llena los valores.
# Nunca pongas claves reales en el repositorio ni en chats o documentos compartidos.

# ---- Cliente (web, extensión, Android) ----
# Temporal: login real y datos simulados. `spacetime` activa los datos reales con membresía.
VITE_DATA_MODE=demo
# URL del servidor SpacetimeDB (ws:// en local, wss:// en producción)
VITE_SPACETIME_URI=ws://localhost:3000
# Nombre de la base publicada con `npm run spacetime:publish`
VITE_SPACETIME_DB=app-b20
# URL del backend (Gemini BYOK, archivos, push)
VITE_API_URL=http://localhost:8787
# SpacetimeAuth → Clients: ID público (no el client secret). Guía: docs/spacetimeauth.md
VITE_SPACETIMEAUTH_CLIENT_ID=
# Opcionales: clientes separados para extensión y Android; sin ellos se usa el de arriba.
VITE_SPACETIMEAUTH_EXTENSION_CLIENT_ID=
VITE_SPACETIMEAUTH_ANDROID_CLIENT_ID=
VITE_SPACETIMEAUTH_AUTHORITY=https://auth.spacetimedb.com/oidc
# Web/PWA: vacíos usan <origen>/auth/callback y <origen>/auth/logout.
# Registrar ambas direcciones EXACTAS en el panel; en local el origen es http://localhost:5173.
VITE_SPACETIMEAUTH_REDIRECT_URI=
VITE_SPACETIMEAUTH_POST_LOGOUT_REDIRECT_URI=
# Clave pública VAPID para Web Push (la privada solo vive en el backend)
VITE_VAPID_PUBLIC_KEY=

# ---- Backend (apps/api) ----
PORT=8787
# Orígenes permitidos separados por coma (web, extensión, Capacitor)
CORS_ORIGINS=http://localhost:5173,capacitor://localhost,https://localhost
# SpacetimeAuth; audiencias son los mismos Client IDs públicos separados por coma.
OIDC_ISSUER=https://auth.spacetimedb.com/oidc
OIDC_AUDIENCE=
OIDC_JWKS_URI=https://auth.spacetimedb.com/oidc/jwks
# La API comprueba la membresía con el token del usuario antes de permitir acceso a /ai.
SPACETIMEDB_URI=http://localhost:3000
SPACETIMEDB_MODULE=app-b20
# Dónde viven las claves BYOK: `memory` (local, se pierden al reiniciar) o `gcp` (Secret Manager)
SECRET_STORE=memory
# Solo con SECRET_STORE=gcp: proyecto de Google Cloud donde se crean los secretos `byok-*`
GCP_PROJECT_ID=
# Solo con SECRET_STORE=memory: clave de 32 bytes en base64 para cifrarlas.
# Genera una con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BYOK_ENCRYPTION_KEY=
# Modelo de Gemini; confirma el vigente en https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=
# Web Push (privada) y FCM: se configuran en la Etapa 0
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:
